{
  "active_provider": "openai",
  "providers": {
    "openai": {
      "api_key": "",
      "model": "gpt-5-mini-2025-08-07",
      "base_url": "https://api.openai.com/v1",
      "temperature": 0.2,
      "max_tokens": 8000,
      "timeout": 120,
      "gpt5_options": {
        "reasoning_effort": null,
        "reasoning_summary": null,
        "verbosity": "medium",
        "response_format": "json_object",
        "max_output_tokens": 8000,
        "metadata": {},
        "cache_control_type": "none",
        "cache_control_ttl_seconds": null,
        "store": false,
        "include": [],
        "parallel_tool_calls": false,
        "tool_choice": "none",
        "tools": [],
        "service_tier": null,
        "truncation": null,
        "user": null,
        "background": null,
        "extra": {}
      }
    },
    "claude": {
      "api_key": "",
      "model": "claude-sonnet-4-5-20250929",
      "base_url": "https://api.anthropic.com",
      "temperature": 0.2,
      "max_tokens": 8000,
      "timeout": 120
    },
    "deepseek": {
      "api_key": "",
      "model": "deepseek-chat",
      "base_url": "https://api.deepseek.com",
      "temperature": 0.2,
      "max_tokens": 8000,
      "timeout": 120,
      "type": "json_object"
    },
    "openrouter": {
      "api_key": "",
      "model": "qwen/qwen3.5-27b",
      "base_url": "https://openrouter.ai/api/v1",
      "temperature": 0.2,
      "max_tokens": 8000,
      "timeout": 120,
      "site_url": "",
      "site_name": "",
      "type": "json_object"
    },
    "local": {
      "base_url": "http://localhost:8000/v1",
      "model": "qwen3.5-27b",
      "temperature": 0.2,
      "max_tokens": 8000,
      "timeout": 600,
      "response_format": {
        "type": "json_object"
      },
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    },
    "ollama": {
      "base_url": "http://localhost:11434",
      "model": "gpt-oss:20b",
      "timeout": 120,
      "default_request": {
        "stream": false,
        "format": "json",
        "keep_alive": "5m",
        "options": {
          "temperature": 0.2,
          "num_ctx": 8192,
          "num_predict": 8000
        }
      }
    },
    "gemini": {
      "api_key": "",
      "model": "gemini-3.1-pro",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "temperature": 0.2,
      "max_tokens": 8192,
      "timeout": 120,
      "gemini_options": {
        "thinking_level": "low",
        "thinking_budget": 1024,
        "response_mime_type": "application/json",
        "candidate_count": 1,
        "safety_settings": [
          {
            "category": "HARM_CATEGORY_HARASSMENT",
            "threshold": "BLOCK_NONE"
          },
          {
            "category": "HARM_CATEGORY_HATE_SPEECH",
            "threshold": "BLOCK_NONE"
          },
          {
            "category": "HARM_CATEGORY_SEXUALLY_EXPLICIT",
            "threshold": "BLOCK_NONE"
          },
          {
            "category": "HARM_CATEGORY_DANGEROUS_CONTENT",
            "threshold": "BLOCK_NONE"
          }
        ]
      }
    }
  },
  "retry_config": {
    "max_retries": 3,
    "retry_delay": 2,
    "exponential_backoff": true
  }
}
